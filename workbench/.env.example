# Required for a public Render deployment; use a long, unique value.
WORKBENCH_PASSWORD=replace-with-a-long-random-secret

# Create a Google OAuth Web application. The redirect URI must exactly match
# GOOGLE_REDIRECT_URI. Enable Gmail API and request only gmail.readonly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

PORT=3000
